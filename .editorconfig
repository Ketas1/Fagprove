# EditorConfig - https://editorconfig.org
# Shared formatting rules so backend and frontend stay consistent regardless
# of which editor is used. Verified in CI via `dotnet format --verify-no-changes`.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs,css}]
indent_size = 2
quote_type = single

[*.{sln,csproj,props,targets}]
indent_size = 2

[*.cs]
indent_size = 4
max_line_length = 120

# --- C# language conventions -------------------------------------------------
# These are enforcement rules, not suggestions: warnings fail the CI build.

# Prefer explicit types except where the type is obvious from the right side.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern C# syntax.
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion

# Null checking - important, the domain leans on nullable reference types.
csharp_style_conditional_delegate_call = true:suggestion
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning

# using directives outside the namespace, System first.
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Readonly where possible.
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:suggestion

# --- Naming ------------------------------------------------------------------

dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.severity = warning
dotnet_naming_rule.types_are_pascal_case.symbols = type_symbol
dotnet_naming_rule.types_are_pascal_case.style = pascal_case_style
dotnet_naming_symbols.type_symbol.applicable_kinds = class,struct,enum,delegate
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_are_camel_case_with_underscore.severity = warning
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

# --- Analyzer severities -----------------------------------------------------

# Unused usings and unused private members should not reach main.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning

# ConfigureAwait is not needed in ASP.NET Core.
dotnet_diagnostic.CA2007.severity = none

[*.{cs,ts,tsx}]
# Generated code is excluded from formatting checks.
generated_code = false

[**/Migrations/*.cs]
generated_code = true
