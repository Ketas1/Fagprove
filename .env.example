# =============================================================================
# Sport For Alle - environment variables
# =============================================================================
# Copy this file to .env and fill in real values:
#
#     cp .env.example .env
#
# .env is git-ignored. This file is committed and must stay in sync: whenever
# you add a variable anywhere in the stack, add it here with a comment too.
# Never put a real secret in this file.
#
# One .env at the repo root serves both apps - backend (DotNetEnv) and
# frontend (@next/env) each load it explicitly, since neither reads a parent
# directory's .env on its own. See docs/11-utviklingsmiljo.md.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Used by the postgres container and by the backend connection string below.

POSTGRES_USER=sportforalle
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sportforalle

# Host port for the container. Deliberately not 5432: a natively installed
# PostgreSQL usually holds that port, and connections to localhost:5432 would
# then silently reach the wrong server. Inside the compose network the database
# still listens on 5432.
POSTGRES_PORT=5433


# -----------------------------------------------------------------------------
# Backend (.NET 10 API)
# -----------------------------------------------------------------------------
# .NET maps a double underscore to a config-section separator, so
# ConnectionStrings__DefaultConnection sets ConnectionStrings:DefaultConnection.

ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5080

# "localhost;Port=5433" is correct for the documented workflow: database in
# Docker, backend run locally (`dotnet run`). Use "db;Port=5432" - the compose
# service name and its in-network port - only once the api service itself
# also runs inside Docker (see docker-compose.yml, currently commented out).
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=sportforalle;Username=sportforalle;Password=change-me-locally

# Auth0 - the API validates access tokens against these.
# Domain is your tenant, Audience is the API Identifier from the Auth0 dashboard.
Auth0__Domain=your-tenant.eu.auth0.com
Auth0__Audience=https://api.sportforalle.no

# Comma-separated origins allowed to call the API.
Cors__AllowedOrigins=http://localhost:3000


# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------

FRONTEND_PORT=3000

# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time.
# Never put a secret behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Auth0 (@auth0/nextjs-auth0). Generate the secret with:
#     openssl rand -hex 32
AUTH0_SECRET=generate-a-32-byte-hex-string
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Must match Auth0__Audience above so the frontend requests a token the API accepts.
AUTH0_AUDIENCE=https://api.sportforalle.no


# -----------------------------------------------------------------------------
# Email (overdue-loan notifications to guardians)
# -----------------------------------------------------------------------------
# Staff trigger these manually from the system; see docs/05-api.md.
# Use a local catcher (e.g. Mailpit) in development - never send real email
# to a real guardian address from a development environment.

Email__Provider=Console
Email__FromAddress=noreply@sportforalle.no
Email__FromName=Sport For Alle
Email__SmtpHost=localhost
Email__SmtpPort=1025
