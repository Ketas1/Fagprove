## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

## ---------------------------------------------------------------------------
## Frontend: Node / Bun / Next.js
## ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
next-env.d.ts

# Bun
.bun/
bun-debug.log*

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# Caches
.eslintcache
.turbo/
*.tsbuildinfo

## ---------------------------------------------------------------------------
## Environment variables
## ---------------------------------------------------------------------------
## .env is already ignored above. These cover the Next.js variants.
## .env.example IS tracked on purpose - it documents every required variable.

.env.local
.env.*.local
.env.development
.env.production
!.env.example

## ---------------------------------------------------------------------------
## Docker
## ---------------------------------------------------------------------------

# Local compose overrides are per-developer and must not be committed.
docker-compose.override.yml

# Bind-mounted volume data, if a volume is ever pointed at the repo.
.docker-data/
postgres-data/

## ---------------------------------------------------------------------------
## Editors and OS
## ---------------------------------------------------------------------------

.vs/
.idea/
*.swp
*.user
*.suo
Thumbs.db
Desktop.ini
.DS_Store

# VS Code: keep shared settings, ignore personal ones.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

## ---------------------------------------------------------------------------
## Claude Code
## ---------------------------------------------------------------------------
## .claude/ is tracked on purpose - CLAUDE.md, skills and shared settings are
## part of the project. Only personal material is ignored.

.claude/settings.local.json
.claude/skills/worklog/

## ---------------------------------------------------------------------------
## Personal and local-only material
## ---------------------------------------------------------------------------
## Notes, planning documents and scratch files that belong to the developer
## rather than to the project.

*.local.md
NOTES.md
/notater/
docs/**/*.pdf

## ---------------------------------------------------------------------------
## Secrets - never commit these
## ---------------------------------------------------------------------------

*.pem
*.key
*.pfx
appsettings.Local.json
appsettings.*.Local.json
secrets.json
